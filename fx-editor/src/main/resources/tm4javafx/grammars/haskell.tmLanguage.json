{"$schema":"https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json","name":"Haskell","scopeName":"source.haskell","patterns":[{"include":"#comments"},{"include":"#strings"},{"include":"#chars"},{"include":"#numbers"},{"include":"#keywords"},{"include":"#constants"},{"include":"#types"},{"include":"#functions"},{"include":"#operators"},{"include":"#punctuation"}],"repository":{"comments":{"patterns":[{"match":"--.*$","name":"comment.line.double-dash.haskell"},{"begin":"\\{-","end":"-\\}","name":"comment.block.haskell"}]},"strings":{"begin":"\"","end":"\"","name":"string.quoted.double.haskell","patterns":[{"match":"\\\\(?:[abfnrtv\\\\\"'&]|[0-9]+|x[0-9A-Fa-f]+|o[0-7]+)","name":"constant.character.escape.haskell"}]},"chars":{"match":"'(?:\\\\.|[^\\\\'])'","name":"string.quoted.single.character.haskell"},"numbers":{"match":"\\b(?:0[xX][0-9A-Fa-f]+|0[oO][0-7]+|0[bB][01]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\\b","name":"constant.numeric.haskell"},"keywords":{"match":"\\b(module|where|import|qualified|as|hiding|data|newtype|type|class|instance|deriving|do|case|of|if|then|else|let|in|infixl|infixr|infix|foreign|default)\\b","name":"keyword.control.haskell"},"constants":{"match":"\\b(True|False|Nothing|Just)\\b","name":"constant.language.haskell"},"types":{"match":"\\b[A-Z][A-Za-z0-9_']*\\b","name":"entity.name.type.haskell"},"functions":{"match":"\\b([a-z_][A-Za-z0-9_']*)(?=\\s*::)","captures":{"1":{"name":"entity.name.function.haskell"}}},"operators":{"match":"[!#$%&*+./<=>?@\\\\^|~:-]+","name":"keyword.operator.haskell"},"punctuation":{"match":"[()\\[\\]{},;]","name":"punctuation.haskell"}}}