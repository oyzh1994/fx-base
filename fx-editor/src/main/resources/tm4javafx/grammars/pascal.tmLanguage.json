{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pascal",
  "scopeName": "source.pascal",
  "patterns": [
    { "include": "#directives" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "directives": {
      "begin": "\\{\\$",
      "end": "\\}",
      "name": "comment.block.preprocessor.pascal"
    },
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.pascal" },
        { "begin": "\\{", "end": "\\}", "name": "comment.block.pascal" },
        { "begin": "\\(\\*", "end": "\\*\\)", "name": "comment.block.pascal" }
      ]
    },
    "strings": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.pascal",
      "patterns": [
        { "match": "''", "name": "constant.character.escape.pascal" }
      ]
    },
    "chars": {
      "match": "#[0-9]+|#\\$[0-9A-Fa-f]+|\\^[A-Za-z]",
      "name": "string.quoted.single.character.pascal"
    },
    "numbers": {
      "match": "\\$[0-9A-Fa-f]+|\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b",
      "name": "constant.numeric.pascal"
    },
    "keywords": {
      "match": "\\b(program|unit|interface|implementation|uses|begin|end|var|const|type|procedure|function|if|then|else|case|of|for|to|downto|do|while|repeat|until|with|record|class|object|array|set|file|in|is|as|inherited|try|except|finally|raise|goto|label|break|continue|exit|constructor|destructor|property|private|protected|public|published|virtual|override|abstract|static|operator|threadvar|resourcestring)\\b",
      "name": "keyword.control.pascal"
    },
    "types": {
      "match": "\\b(integer|cardinal|byte|word|longint|longword|int64|shortint|smallint|real|single|double|extended|currency|comp|boolean|bytebool|wordbool|longbool|char|ansichar|widechar|string|ansistring|widestring|shortstring|pointer|variant|olevariant)\\b",
      "name": "storage.type.pascal"
    },
    "constants": {
      "match": "\\b(true|false|nil)\\b",
      "name": "constant.language.pascal"
    },
    "functions": {
      "match": "\\b(procedure|function|constructor|destructor)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.pascal" },
        "2": { "name": "entity.name.function.pascal" }
      }
    },
    "operators": {
      "match": "(?i:\\b(?:and|or|xor|not|shl|shr|div|mod|in|is|as)\\b)|:=|<>|<=|>=|\\.\\.|[=<>+\\-*/@^]",
      "name": "keyword.operator.pascal"
    },
    "punctuation": {
      "match": "[()\\[\\]{},;.:]",
      "name": "punctuation.pascal"
    }
  }
}
