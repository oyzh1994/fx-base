{"$schema":"https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json","name":"Zig","scopeName":"source.zig","patterns":[{"include":"#comments"},{"include":"#multiline-strings"},{"include":"#strings"},{"include":"#chars"},{"include":"#numbers"},{"include":"#keywords"},{"include":"#builtin-functions"},{"include":"#types"},{"include":"#functions"},{"include":"#operators"},{"include":"#punctuation"}],"repository":{"comments":{"match":"//.*$","name":"comment.line.double-slash.zig"},"multiline-strings":{"begin":"\\\\\\\\","end":"$","name":"string.quoted.multiline.zig"},"strings":{"begin":"\"","end":"\"","name":"string.quoted.double.zig","patterns":[{"match":"\\\\.","name":"constant.character.escape.zig"}]},"chars":{"match":"'(?:\\\\.|[^\\\\'])'","name":"string.quoted.single.character.zig"},"numbers":{"match":"\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b","name":"constant.numeric.zig"},"keywords":{"match":"\\b(const|var|fn|pub|export|extern|inline|noinline|comptime|struct|enum|union|error|opaque|if|else|switch|while|for|break|continue|return|defer|errdefer|try|catch|async|await|suspend|resume|nosuspend|asm|unreachable|usingnamespace|test|threadlocal|allowzero|volatile|align|linksection|callconv|noalias|anytype|anyframe|packed|and|or)\\b","name":"keyword.control.zig"},"builtin-functions":{"match":"@[A-Za-z_][A-Za-z0-9_]*","name":"support.function.builtin.zig"},"types":{"match":"\\b(?:i[0-9]+|u[0-9]+|isize|usize|f(?:16|32|64|80|128)|bool|void|noreturn|type|anyerror|anyopaque|comptime_int|comptime_float|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_char|c_short|c_ushort)\\b","name":"storage.type.zig"},"functions":{"match":"\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)","captures":{"1":{"name":"entity.name.function.zig"}}},"operators":{"match":"(?:\\*\\*|==|!=|<=|>=|<<|>>|\\+\\+|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|\\+%|-%|\\*%|\\+\\|=|-\\|=|\\*\\|=|=>|->|\\.\\?|\\.\\*)|[-+*/%=<>!&|^~?.]","name":"key