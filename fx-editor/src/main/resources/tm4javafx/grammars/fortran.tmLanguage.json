{"$schema":"https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json","name":"Fortran","scopeName":"source.fortran","patterns":[{"include":"#comments"},{"include":"#strings"},{"include":"#numbers"},{"include":"#keywords"},{"include":"#types"},{"include":"#operators"},{"include":"#punctuation"}],"repository":{"comments":{"match":"!.*$","name":"comment.line.exclamation.fortran"},"strings":{"patterns":[{"begin":"'","end":"'","name":"string.quoted.single.fortran","patterns":[{"match":"''","name":"constant.character.escape.fortran"}]},{"begin":"\"","end":"\"","name":"string.quoted.double.fortran","patterns":[{"match":"\"\"","name":"constant.character.escape.fortran"}]}]},"numbers":{"match":"\\b[0-9]+(?:\\.[0-9]*)?(?:[dDeE][+-]?[0-9]+)?(?:_[A-Za-z0-9]+)?\\b","name":"constant.numeric.fortran"},"keywords":{"match":"\\b(program|end|module|submodule|contains|subroutine|function|call|if|then|else|elseif|endif|do|enddo|while|select|case|default|endselect|where|elsewhere|endwhere|type|interface|abstract|procedure|use|implicit|none|intent|in|out|inout|parameter|dimension|allocatable|pointer|target|save|public|private|return|stop|cycle|exit|goto|continue|allocate|deallocate|open|close|read|write|print|format|external|pure|elemental|recursive|result)\\b","name":"keyword.control.fortran"},"types":{"match":"\\b(integer|real|double|precision|complex|logical|character|class)\\b","name":"storage.type.fortran"},"operators":{"match":"(?i:\\b\\.(?:eq|ne|lt|le|gt|ge|and|or|not|true|false|eqv|neqv)\\.)|\\*\\*|//|[=<>+\\-*/,]","name":"keyword.operator.fortran"},"punctuation":{"match":"[()\\[\\]{}:;%]","name":"punctuation.fortran"}}}