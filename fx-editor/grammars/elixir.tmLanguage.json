{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Elixir",
  "scopeName": "source.elixir",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sigils" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#atoms" },
    { "include": "#modules" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.elixir"
    },
    "sigils": {
      "begin": "~([rRsSwWcC])?([/|\\[({<])",
      "end": "\\2([a-zA-Z]*)",
      "name": "string.quoted.other.sigil.elixir"
    },
    "strings": {
      "patterns": [
        { "begin": "\"\"\"", "end": "\"\"\"", "name": "string.quoted.triple.elixir" },
        { "begin": "\"", "end": "\"", "name": "string.quoted.double.elixir", "patterns": [
          { "match": "\\\\.", "name": "constant.character.escape.elixir" },
          { "begin": "#\\{", "end": "\\}", "name": "meta.embedded.line.elixir" }
        ] },
        { "begin": "'", "end": "'", "name": "string.quoted.single.elixir", "patterns": [
          { "match": "\\\\.", "name": "constant.character.escape.elixir" }
        ] }
      ]
    },
    "chars": {
      "match": "\\?(?:\\\\[a-zA-Z0-9]+|.)",
      "name": "string.quoted.single.character.elixir"
    },
    "numbers": {
      "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b",
      "name": "constant.numeric.elixir"
    },
    "keywords": {
      "match": "\\b(def|defp|defmodule|defmacro|defmacrop|defstruct|defprotocol|defimpl|defdelegate|defguard|defexception|if|unless|case|cond|for|with|do|end|fn|when|and|or|not|in|import|require|use|alias|raise|rescue|after|catch|else|try|receive|super|quote|unquote)\\b",
      "name": "keyword.control.elixir"
    },
    "atoms": {
      "match": ":[A-Za-z_][A-Za-z0-9_!?]*",
      "name": "constant.other.symbol.elixir"
    },
    "modules": {
      "match": "\\b[A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*\\b",
      "name": "entity.name.type.module.elixir"
    },
    "functions": {
      "match": "\\b[a-z_][A-Za-z0-9_!?]*(?=\\s*\\()",
      "name": "entity.name.function.elixir"
    },
    "operators": {
      "match": "(?:\\|>|<<<|>>>|<>|==|!=|=~|===|!==|<=|>=|->|<-|\\\\\\\\)|[-+*/=<>&|^~.]+",
      "name": "keyword.operator.elixir"
    },
    "punctuation": {
      "match": "[()\\[\\]{},;]",
      "name": "punctuation.elixir"
    }
  }
}
