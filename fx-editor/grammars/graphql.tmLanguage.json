{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GraphQL",
  "scopeName": "source.graphql",
  "patterns": [
    { "include": "#comments" },
    { "include": "#block-strings" },
    { "include": "#strings" },
    { "include": "#variables" },
    { "include": "#directives" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.graphql"
    },
    "block-strings": {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.graphql"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.graphql",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.graphql" }
      ]
    },
    "variables": {
      "match": "\\$[_A-Za-z][_0-9A-Za-z]*",
      "name": "variable.other.graphql"
    },
    "directives": {
      "match": "@[_A-Za-z][_0-9A-Za-z]*",
      "name": "entity.name.function.decorator.graphql"
    },
    "keywords": {
      "match": "\\b(query|mutation|subscription|fragment|on|type|interface|union|enum|input|scalar|schema|extend|directive|implements|repeatable)\\b",
      "name": "keyword.control.graphql"
    },
    "constants": {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.graphql"
    },
    "numbers": {
      "match": "\\b-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b",
      "name": "constant.numeric.graphql"
    },
    "types": {
      "match": "\\b[A-Z][_0-9A-Za-z]*\\b",
      "name": "entity.name.type.graphql"
    },
    "operators": {
      "match": "[!=|&:]+",
      "name": "keyword.operator.graphql"
    },
    "punctuation": {
      "match": "[{}()\\[\\],]",
      "name": "punctuation.definition.graphql"
    }
  }
}
